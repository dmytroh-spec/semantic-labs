        <https://example.org/tourism/attraction/landscape-alley>,
        <https://example.org/tourism/attraction/national-history-museum>,
        <https://example.org/tourism/attraction/one-street-museum> ;
    tour:recommendedSeason "autumn" .

<https://example.org/tourism/route/green-kyiv> a tour:TouristRoute ;
