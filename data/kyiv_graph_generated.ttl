@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix tour: <https://example.org/tourism/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tour:Attraction a rdfs:Class .

tour:AttractionType a rdfs:Class .

tour:City a rdfs:Class .

tour:Country a rdfs:Class .

tour:TouristRoute a rdfs:Class .

<https://example.org/tourism/route/ancient-kyiv> a tour:TouristRoute ;
    rdfs:label "Стародавній Київ"@uk ;
    tour:includesAttraction <https://example.org/tourism/attraction/golden-gate>,
        <https://example.org/tourism/attraction/national-history-museum>,
        <https://example.org/tourism/attraction/saint-sophia> ;
    tour:recommendedSeason "spring" .

<https://example.org/tourism/route/andriivskyi-descent> a tour:TouristRoute ;
    rdfs:label "Андріївський узвіз і Поділ"@uk ;
